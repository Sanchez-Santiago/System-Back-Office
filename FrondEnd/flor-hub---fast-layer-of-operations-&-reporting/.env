# ============================================
# CONFIGURACIÓN DE LA API
# ============================================

# URL del backend API
# Para desarrollo local: http://localhost:8000
# Para producción: https://tu-dominio.com
VITE_API_URL=http://localhost:8000/

# Timeout para peticiones API (ms)
VITE_API_TIMEOUT=30000

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================

VITE_APP_NAME=FLOR
VITE_APP_VERSION=1.0.0

# Environment: development | production
VITE_APP_ENV=development

# ============================================
# FEATURE FLAGS
# ============================================

# Habilitar mocks (útil para desarrollo sin backend)
VITE_ENABLE_MOCKS=false

# Habilitar logs de debug
VITE_ENABLE_DEBUG=false

# ============================================
# NOTAS
# ============================================
# - Copiar este archivo a .env.local para desarrollo local
# - Nunca subir credenciales reales a git
# - El archivo .env.local está en .gitignore
# - En modo desarrollo, si ENABLE_DEBUG=true se muestran logs detallados
# - En modo desarrollo, si ENABLE_MOCKS=true no se necesita backend
# - En modo desarrollo, si VITE_INSPECTION_MODE=true se bypassa el login y se muestran datos simulados para análisis visual.

# ============================================
# MODO DE INSPECCIÓN VISUAL (UI)
# ============================================
VITE_INSPECTION_MODE=true
VITE_INSPECTION_THEME=modern
